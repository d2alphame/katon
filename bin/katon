#! /usr/bin/env perl

use v5.34;
use strict;
use warnings;

use Getopt::Long qw(:config no_ignore_case no_auto_abbrev);
use Pod::Usage;

my $help = 0;


GetOptions(
    'help|h' => \$help
) or pod2usage(2);
pod2usage(-verbose => 2, -exitval => 0) if $help;


# After 'GetOptions' processing, 
# If no arguments are given, display summary and exit
unless (@ARGV) { 
    say "Katon text replacement macroprocessor";
    exit 0;
}

# Take whatever is left as input file(s)
for my $infile(@ARGV) {
    exit 1  unless -e $infile;
    die "File '$infile' does not exist.\n" unless(-e $infile); 
}


__END__
=head1 NAME

Katon text replacement macroprocessor

=head1 SYNOPSIS

Katon is a text replacement macroprocessor. 