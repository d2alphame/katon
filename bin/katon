#! /usr/bin/perl

use v5.34;
use strict;
use warnings;

use Getopt::Long qw(:config no_ignore_case no_auto_abbrev);
use Pod::Usage;

my $help = 0;
my $dest = '';      # Destination file. Use --out or -o for this

# First, if nothing is passed on the command line, show summary and exit
unless(@ARGV) {
    say "Katon is a text replacement macroprocessor. Use --help or -h to get help.";
    exit 0;
}

# Process command line options
GetOptions(
    'out|o=s'   => \$dest,
    'help|h'    => \$help
) or pod2usage(-verbose => 1, -exitval => 1, -section => [ 'USAGE' ]);

# Show help and exit if --help or -h is passed in
pod2usage(-verbose => 1, -exitval => 0) if $help;

# If no arguments are left in @ARGV after processing options, that implies that no source file was given. Show usage and
# exit.
unless(@ARGV) {
    pod2usage
        -message => 'No source file specified.',
        -verbose => 1,
        -exitval => 1, 
        -sections => [ qw( USAGE ) ]
}



my $outfh;
while(@ARGV) {
    my $infile = shift @ARGV;
    die "File '$infile' does not exist.\n" unless(-e $infile);
    open my $infh, '<', $infile 
        or die "Could not open input file '$infile': $!";
    if($dest) {
        $outfh = undef;
        open $outfh, '>', $dest
            or die "Could not open destination file '$dest': $!";
    }

    while(my $line = <$infh>) {
        if($outfh) {
            print $outfh $line;
        } else {
            print $line;
        }
    }
}


__END__

=head1 NAME

Katon is a text replacement macroprocessor. It copies the content of a source file to an output file while substituting
variables. It copies to STDOUT if no output file is specified.


=head1 SYNOPSIS

    katon <source_file>
    katon <source_file> --out <output_file>
    katon <source_file> --var-file <variables_file> --out <output_file>
    katon <source_file> --var 'VAR1=value1' --var 'VAR2=value2' --out <output_file>


=head1 DESCRIPTION

At its simplest, katon echoes the content of a given file to another file while substituting variables. The output file
can be specified using the --out (or -o) option. If an output file is not specified, the output will be printed to
STDOUT. The content of the source file is printed as-is if there are no variables in it to substitute.

