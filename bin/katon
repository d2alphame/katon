#! /usr/bin/perl

use v5.34;
use strict;
use warnings;

use threads;
use threads::shared;
use Getopt::Long qw(:config no_ignore_case no_auto_abbrev);
use Pod::Usage;

sub process_file($$);
sub process_env();
sub process_var_file($);

my $help = 0;
my $dest = '';      # Destination file. Use --out or -o for this
my %env;            # Environment variables that can be substituted
my %vars :shared;   # User-defined variables that can be substituted
my $var_file = '';  # Variable file. --var-file option

# First, if nothing is passed on the command line, show summary and exit
unless(@ARGV) {
    say "Katon is a text replacement macroprocessor. Use --help or -h to get help.";
    exit 0;
}

# Process command line options
GetOptions(
    'out|o=s'   => \$dest,
    'help|h'    => \$help,
    'var=s'     => \%vars,
    'var-file=s'=> \$var_file
) or pod2usage(-verbose => 1, -exitval => 1, -section => [ 'USAGE' ]);

# Show help and exit if --help or -h is passed in
pod2usage(-verbose => 3, -exitval => 0) if $help;

# If no arguments are left in @ARGV after processing options, that implies that no source file was given. Show usage and
# exit with error.
unless(@ARGV) {
    pod2usage
        -message => 'No source file specified.',
        -verbose => 1,
        -exitval => 1, 
        -sections => [ qw( USAGE ) ]
}

process_env;

my $process_var_file_thread;
if($var_file) {
    $process_var_file_thread = threads->create(\&process_var_file, $var_file)
}

my $outfh;
while(@ARGV) {
    my $infile = shift @ARGV;

    die "File '$infile' does not exist.\n" unless(-e $infile);
    open my $infh, '<', $infile 
        or die "Could not open input file '$infile': $!";
    
    if($dest) {
        $outfh = undef;
        open $outfh, '>', $dest
            or die "Could not open destination file '$dest': $!";
    }

    $process_var_file_thread->join;
    process_file $infh, $outfh;
}



# This subroutine process_file() takes 2 parameters. The first parameter is the file handle of the input or source file
# and the second parameter the output or destination files.
# It processes the content of the input file and prints the result to the output file.
sub process_file($$) {
    my ($ifh, $ofh) = @_;
    $ofh //= *STDOUT;

    while(<$ifh>) {
        /\G \n /gcx                       && print "\n"           and next;  # Newline means end of the line
        /\G \$(\$+) /gcx                  && print $ofh $1        and redo;  # Use an extra $ to escape any number of $
        /\G \$env\.([a-zA-Z0-9_-]+) /gcx  && print $ofh $env{$1}  and redo;  # Substitute environment variables
        /\G \$var\.([a-zA-Z0-9_-]+) /gcx  && print $ofh $vars{$1} and redo;  # Substitute var variables
        /\G ([^\$]+) /gcx                 && print $ofh $1        and redo;  # Print normal text.
    }
}



# Process the environment variables. Katon only processes environment variables that begin with 'KT_'. The 'KT_' prefix
# is stripped off so that the variable name becomes what comes after 'KT_'. For example, if you set the environment
# variable name KT_SOME_VAR, it can be accessed in the input file as $env.SOME_VAR.
sub process_env() {
    while(my ($key, $value) = each %ENV){
        if($key =~ s/^KT_//) {
            $env{$key} = $value;
        }
    }
}


# Process variables passed in variable files. The file is passed in as the value of the --var-file option. The variable
# file's format is a subset of the Derml format. See the Derml documentation at https://github.com/d2alphame/derml
sub process_var_file($) {
    my $file = shift;
    die "Variable file $file does not exist.\n" unless(-e $file);
    open my $handle , '<', $file
        or die "Could not open variable file $file: $!";

    my $var_name;
    while(<$handle>) {

        next if /\G \s* \#.* $ /gcx;           # Skip comments
        next if /\G \s* $/x;                    # Skip blank lines
        
        # Get ready to get a variable assignment
        if(/ \G \s* ([A-Za-z0-9\._-]+) \s+/gcx) {
            $var_name = $1;
            # Standard values assigned with '='
            if(/\G = \s+ /gcx) {
                # Quoted with double quotes
                if(/\G " ([^"]+) " /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with single quotes
                elsif(/\G ' ([^']+) ' /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with backticks
                elsif(/\G ` ([^`]+) ` /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with parens
                elsif(/\G \( ([^)]+) \) /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with braces
                elsif(/\G \{ ([^}]+) \} /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with angles
                elsif(/\G < ([^>]+) > /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Quoted with squares
                elsif(/\G \[ ([^\]]+) \] /gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                # Unquoted value. From first non-whitespace to end of line
                elsif(/\G (\S.*) $/gcx) {
                    $vars{$var_name} = $1;
                    redo;
                }
                #else {
                #    #redo;
                #    # TODO: Error out
                #}
            }
            # Long values assigned with <. Long values should start on the next line
            elsif(/\G < \s* $/gcx) {
                my $long_value = '';
                while(1) {
                    last if eof;
                    $_ = <$handle>;         # Read next line. This would be the first line of the long value
                    last if /^s*$/;
                    s/^\s+//;               # Remove leading whitespace
                    s/\s+$/ /;              # Concatenate trailing spaces into 1
                    chomp;                  # Remove final newline
                    $long_value .= $_;
                }
                $vars{$var_name} = $long_value;
                next;
            }
            # Multiline values assigned with | and a delimiting string. The delimiting string must contain at least 1
            # non-whitespace character. The lone delimiter on a line and possibly surrounded by spaces marks the end
            # of the value
            elsif(/\G \| \s+ (\S.*) $ /gcx) {
                my $delim = $1;
                my $multiline_value = '';
                while(1) {
                    last if eof;
                    $_ = <$handle>;
                    last if /^ \s* $delim \s* $/x;
                    s/^\s*//;
                    $multiline_value .= $_;
                }
                $vars{$var_name} = $multiline_value;
                next;
            }
            # "Pythonic values assigned with >". This basically just lets you assign some pythonish or yaml-like code
            # to a variable
            elsif(/\G > \s+ (\S.*) $ /gcx) {
                my $delim = $1;
                my $pythonic_value = '';
                $_ = <$handle>;
                my $indent_level = length $1 if s/^ (\s*) //x;
                $pythonic_value .= $_;
                while(1) {
                    last if eof;
                    $_ = <$handle>;
                    last if /^ \s* $delim \s* $/x;
                    if(s/^\s{$indent_level}//) { 
                        $pythonic_value .= $_;
                        next
                    }
                    else {
                        # TODO: Error out
                        die "Syntax error in file\n";
                    }
                }
                $vars{$var_name} =  $pythonic_value;
            }
        }
    }
}

__END__

=head1 NAME

Katon is a text replacement macroprocessor. It copies the content of a source file to an output file while substituting
variables. It copies to STDOUT if no output file is specified.


=head1 SYNOPSIS

    katon <source_file>
    katon <source_file> --out <output_file>
    katon <source_file> --var-file <variables_file> --out <output_file>
    katon <source_file> --var 'VAR1=value1' --var 'VAR2=value2' --out <output_file>


=head1 DESCRIPTION

At its simplest, katon echoes the content of a given file to another file while substituting variables. The output file
can be specified using the --out (or -o) option. If an output file is not specified, the output will be printed to
STDOUT. The content of the source file is printed as-is if there are no variables in it to substitute.


=head2 Escaping

Use an extra C<$> sign to escape any number of dollar (C<$>) signs. To substitute 3 dollar signs, for example, use 4 as
in:

    $$$$

The above becomes

    $$$

in the output.

This means to output n dollar signs, use n+1 dollar signs in the input. To output 5 dollar signs, use 6 as in:

    $$$$$$

The output will be

    $$$$$


=head2 Substituting Environment Variables

When substituting environment variables, only environment variables that begin with 'KT_' will be substituted. For
example to substitute the environment variable 'SOME_VAR', set the environment variable KT_SOME_VAR and access it with
$env.SOME_VAR.

Set the environment variable KT_SOME_VAR and invoke C<katon>

    KT_SOME_VAR="Some Value"
    katon input_file

In the input file, substitute the environment variable with:

    $env.SOME_VAR


=head2 Substituting C<--var> Variables

Multiple C<--var> options can be specified from the command line using the C<variable=value> format. These variables
can be accessed from the source file as C<var.variable_name>.

    katon input_file --var first=alpha --var second=beta --var third=gamma

These variables can be substituted with C<var.first>, C<var.second>, and C<var.third>.


=head2 A Primer on Derml

Katon uses a subset of Derml. Variable names can be any combination of letters (upper case and lower case), numbers,
dots (the period characters), dashes and underscores. Comments start with the hash symbol (#) continue on to the end of
the line.

    # This is a comment

Values can be quoted or unquoted. Values may also span multiple lines. There are 7 quoting mechanisms, they are: double
quotes ("), apostrophe ('), backticks (`), parentheses (()), braces ({}), angular brackets (<>), and square brackets
([]). All assignment operators I<must always> be surrounded by spaces. Assignments with unquoted values cannot have
inlined comments as Derml will take the comment as part of the value.

    # This is an assignment with an unquoted value
    Show = Avatar the Last Airbender

    # Comments cannot be inlined for unquoted value assignments
    main_character = Aang         # Derml will think this comment is part of the value

    # There's always spaces around assignment operators. The following, for example, would be wrong
    LoveInterest=Katara
    r_o_l_e= Protagonist
    Bending-Element =Air

The last 3 assignments in the previous example are wrong because there are no spaces around the assignment operator.

The following are examples with quoted values. Quoted assignments may have inlined comments.

    Air   = "Aang"
    Fire  = 'Roku'     # Inlined comment can be added to quoted values
    Earth = `Kyoshi`   # This one is quoted with back ticks
    Water = (Kuruk)    # This one is quoted using parenthesis

    Person.dir = <C:\Users\Boomerang User\Sokka>  # Angular backets for quotes
    best-sokkasm = {Sokka said "Looks like Long Feng is Long gone"}
    Ep1s0d3_M41n_point = [It's Azula's breakdown]


